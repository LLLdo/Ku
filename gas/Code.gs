const SHEET_NAME='Registrations';
const HEADERS=['timestamp','name','department','position','phone','email','follower','count','ages','allergies','allergyDetail','diet','dietOther','activity','subActivity','otherActivity','signature'];
function setup(){const ss=SpreadsheetApp.getActive();let sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(HEADERS);}
function doPost(e){try{setup();const b=JSON.parse(e.postData.contents||'{}');if(b.action!=='register')throw Error('Invalid action');const sh=SpreadsheetApp.getActive().getSheetByName(SHEET_NAME);sh.appendRow([new Date(),b.name,b.department||'',b.position||'',b.phone||'',b.email||'',b.follower?'true':'false',b.count||0,Array.isArray(b.ages)?b.ages.join(', '):'',Array.isArray(b.allergies)?b.allergies.join(', '):'',b.allergyDetail||'',b.diet||'',b.dietOther||'',b.activity||'',b.subActivity||'',b.otherActivity||'',b.signature||'']);return json({ok:true})}catch(err){return json({ok:false,error:String(err)})}}
function doGet(e){try{setup();const sh=SpreadsheetApp.getActive().getSheetByName(SHEET_NAME);const values=sh.getDataRange().getValues();if(values.length<2)return json({rows:[]});const headers=values.shift();const rows=values.map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i] instanceof Date?r[i].toISOString():r[i]])));return json({rows})}catch(err){return json({rows:[],error:String(err)})}}
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}